{
  "_about": "The search grammar's cases, read by both parsers: zimi/query.py (tests/test_search_query.py) and parseSearchQuery in zimi/static/app.js (tests/test_search_query.cjs). A term written \"like this\" is a phrase. groups: every group must match, any one term inside a group does.",
  "parse": [
    {"q": "water filter", "groups": [["water"], ["filter"]], "exclude": [], "filters": [], "plain": true},
    {"q": "Water  Filter ", "groups": [["water"], ["filter"]], "exclude": [], "filters": [], "plain": true},
    {"q": "", "groups": [], "exclude": [], "filters": [], "plain": true},
    {"q": "wikipedia -ted", "groups": [["wikipedia"]], "exclude": ["ted"], "filters": [], "plain": false},
    {"q": "-ted", "groups": [], "exclude": ["ted"], "filters": [], "plain": false},
    {"q": "--ted", "groups": [], "exclude": ["ted"], "filters": [], "plain": false},
    {"q": "-", "groups": [], "exclude": [], "filters": [], "plain": false},
    {"q": "water - filter", "groups": [["water"], ["filter"]], "exclude": [], "filters": [], "plain": false},
    {"q": "e-mail", "groups": [["e-mail"]], "exclude": [], "filters": [], "plain": true},
    {"q": "x-ray -e-mail", "groups": [["x-ray"]], "exclude": ["e-mail"], "filters": [], "plain": false},
    {"q": "\"common law\"", "groups": [["\"common law\""]], "exclude": [], "filters": [], "plain": false},
    {"q": "“common  law” england", "groups": [["\"common law\""], ["england"]], "exclude": [], "filters": [], "plain": false},
    {"q": "law -\"common law\"", "groups": [["law"]], "exclude": ["\"common law\""], "filters": [], "plain": false},
    {"q": "\"common law", "groups": [["common"], ["law"]], "exclude": [], "filters": [], "plain": false},
    {"q": "common law\"", "groups": [["common"], ["law"]], "exclude": [], "filters": [], "plain": false},
    {"q": "\"\"", "groups": [], "exclude": [], "filters": [], "plain": false},
    {"q": "cats OR dogs", "groups": [["cats", "dogs"]], "exclude": [], "filters": [], "plain": false},
    {"q": "pet cats OR dogs OR birds food", "groups": [["pet"], ["cats", "dogs", "birds"], ["food"]], "exclude": [], "filters": [], "plain": false},
    {"q": "OR cats", "groups": [["cats"]], "exclude": [], "filters": [], "plain": false},
    {"q": "cats OR", "groups": [["cats"]], "exclude": [], "filters": [], "plain": false},
    {"q": "cats OR OR dogs", "groups": [["cats", "dogs"]], "exclude": [], "filters": [], "plain": false},
    {"q": "cats or dogs", "groups": [["cats"], ["or"], ["dogs"]], "exclude": [], "filters": [], "plain": true},
    {"q": "\"new york\" OR boston", "groups": [["\"new york\"", "boston"]], "exclude": [], "filters": [], "plain": false},
    {"q": "cats OR -dogs", "groups": [["cats"]], "exclude": ["dogs"], "filters": [], "plain": false},
    {"q": "東京 -大阪", "groups": [["東京"]], "exclude": ["大阪"], "filters": [], "plain": false},
    {"q": "Москва -Петербург", "groups": [["москва"]], "exclude": ["петербург"], "filters": [], "plain": false},
    {"q": "ماء -نار", "groups": [["ماء"]], "exclude": ["نار"], "filters": [], "plain": false},
    {"q": "whale in:wikipedia", "groups": [["whale"]], "exclude": [], "filters": [["source", "wikipedia", false]], "plain": false},
    {"q": "whale source:Wikipedia lang:FR", "groups": [["whale"]], "exclude": [], "filters": [["source", "wikipedia", false], ["lang", "fr", false]], "plain": false},
    {"q": "talks -in:ted", "groups": [["talks"]], "exclude": [], "filters": [["source", "ted", true]], "plain": false},
    {"q": "in: whale", "groups": [["in:"], ["whale"]], "exclude": [], "filters": [], "plain": true},
    {"q": "c++: http://x.org", "groups": [["c++:"], ["http://x.org"]], "exclude": [], "filters": [], "plain": true},
    {"q": "size:big", "groups": [["size:big"]], "exclude": [], "filters": [], "plain": true}
  ],
  "match": [
    {"q": "-ted", "text": "TED Talks: Science", "match": false},
    {"q": "-ted", "text": "ted_en_science", "match": false},
    {"q": "-ted", "text": "TEDx Berlin", "match": false},
    {"q": "-ted", "text": "United States history", "match": true},
    {"q": "wiki", "text": "Wikipedia in English", "match": true},
    {"q": "wikipedia -ted", "text": "Wikipedia in English", "match": true},
    {"q": "\"common law\"", "text": "The Common Law", "match": true},
    {"q": "\"common law\"", "text": "Law, common and civil", "match": false},
    {"q": "\"ted talk\"", "text": "a posted talk", "match": false},
    {"q": "cats OR dogs", "text": "All about dogs", "match": true},
    {"q": "cats OR dogs", "text": "All about birds", "match": false},
    {"q": "pet cats OR dogs", "text": "dogs", "match": false},
    {"q": "e-mail", "text": "E-mail etiquette", "match": true},
    {"q": "mail -e-mail", "text": "E-mail etiquette", "match": false},
    {"q": "東京 -大阪", "text": "東京と大阪の歴史", "match": false},
    {"q": "東京 -大阪", "text": "東京の歴史", "match": true},
    {"q": "Москва -Петербург", "text": "Москва и Петербург", "match": false},
    {"q": "-", "text": "anything", "match": true}
  ]
}
