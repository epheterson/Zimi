.git
.github
__pycache__
*.md
.gitignore
.dockerignore
.env
zims/
*.zim
!zimi/builtin/*.zim
.DS_Store
# The ZIMs' source folders are for `python -m zimi.ownzims` in a checkout; the
# server reads only games.json and the tile pictures (zimi/gamelinks.py).
zimi/builtin/almanac
zimi/builtin/games/*
!zimi/builtin/games/games.json
!zimi/builtin/games/thumbs
zimi/builtin/games/puzzles/*
!zimi/builtin/games/puzzles/icons
